server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SSE: proxy_buffering off + 長めの read timeout で EventSource が途切れない
    location ~ ^/alerts/stream {
        proxy_pass ${BACKEND_EDGE_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA ルートと衝突するパス: ブラウザナビゲーション（Accept: text/html）は index.html へ
    # fetch / EventSource はそのままバックエンドへ転送（vite proxy の bypass と同じ挙動）
    location ~ ^/(alerts|analytics) {
        if ($http_accept ~* "text/html") {
            rewrite ^ /index.html last;
        }
        proxy_pass ${BACKEND_EDGE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # API 専用パス（対応する SPA ルートなし）
    location ~ ^/(demo|patterns|forecast|health) {
        proxy_pass ${BACKEND_EDGE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }
}

#!/bin/bash
# GCE backbone 起動スクリプト（Ubuntu LTS 前提）。
# Docker + compose plugin を入れ、GCS の docker-compose.prod.yml を取得して up する。
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

# 1) Docker（compose plugin 同梱）
if ! command -v docker >/dev/null 2>&1; then
  curl -fsSL https://get.docker.com | sh
fi

# Elasticsearch が必要とする vm.max_map_count を設定（未設定だと ES が起動しない）
sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" >> /etc/sysctl.conf

mkdir -p /opt/app
cd /opt/app

# 2) VM の SA アクセストークン（cloud-platform scope）を metadata から取得
TOKEN=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')

# 3) Artifact Registry ログイン（gcloud/gsutil 不要）
echo "$TOKEN" | docker login -u oauth2accesstoken --password-stdin "https://${artifact_host}"

# 4) compose 定義を GCS Storage JSON API から取得（base + override）
curl -fsS -H "Authorization: Bearer $TOKEN" \
  -o /opt/app/docker-compose.base.yml \
  "https://storage.googleapis.com/storage/v1/b/${compose_bucket}/o/docker-compose.yml?alt=media"

curl -fsS -H "Authorization: Bearer $TOKEN" \
  -o /opt/app/docker-compose.prod.yml \
  "https://storage.googleapis.com/storage/v1/b/${compose_bucket}/o/${compose_object}?alt=media"

# 5) Secret Manager からシークレットを取得（VM SA = roles/secretmanager.secretAccessor）。
#    $TOKEN は step2 のアクセストークンを再利用。payload.data は base64 なのでデコードする。
INGEST_TOKEN=$(curl -sf -H "Authorization: Bearer $TOKEN" \
  "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/INGEST_TOKEN/versions/latest:access" \
  | sed -n 's/.*"data": *"\([^"]*\)".*/\1/p' | base64 -d)

# GitHub PAT（read-only）: AI 調査のコミット履歴収集＋証拠リンク＋修正PR起票に使う。
# INGEST_TOKEN と違い「未投入でも起動を止めない」オプショナル扱い。secret に version が無い/取得失敗なら
# 空にフォールバックする（|| true）。空なら GitHubGatewayImpl が silent skip するだけ（証拠リンクが出ないのみ）。
GITHUB_TOKEN=$(curl -sf -H "Authorization: Bearer $TOKEN" \
  "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/GITHUB_TOKEN/versions/latest:access" 2>/dev/null \
  | sed -n 's/.*"data": *"\([^"]*\)".*/\1/p' | base64 -d 2>/dev/null || true)

# 6) イメージ参照・プロジェクト・シークレットを .env に。
#    DEMO_ENABLED=true: この本番デプロイはハッカソン・デモ環境そのもの（デモコンソール/シナリオを出す）。
#    その他の非シークレット（GITHUB_TARGET_REPO/REF・REMEDIATION_MODE 等）は compose の default 側で持つ。
cat > /opt/app/.env <<EOF
GCP_PROJECT_ID=${project_id}
IMAGE_EC=${image_ec}
IMAGE_BACKOFFICE=${image_backoffice}
INGEST_TOKEN=$INGEST_TOKEN
GITHUB_TOKEN=$GITHUB_TOKEN
DEMO_ENABLED=true
EOF

# 7) 起動（base + prod override）。イメージはpush済みなのでビルドをスキップ
docker compose --env-file /opt/app/.env -f /opt/app/docker-compose.base.yml -f /opt/app/docker-compose.prod.yml up -d --no-build

# 8) Ops Agent: GCE 上の Docker コンテナのアプリ構造化ログ（JSON）を Cloud Logging へ転送する。
#    既定の Ops Agent は systemd journal と /var/log しか見ず docker コンテナログを収集しないため、
#    files receiver で json-file ドライバのログ（/var/lib/docker/containers/*/*-json.log）を tail し、
#    二段 JSON パース（外＝docker wrapper の "log" 取り出し → 内＝アプリの構造化ログ）を行い、
#    アプリの severity フィールドを LogEntry.severity に昇格させる。
#    これで「アプリ CRITICAL ログ検知」ポリシー（severity>=CRITICAL AND resource.type=gce_instance）が
#    発火し、webhook 経由で /ingest/cloud-monitoring に届く（経路B）。AI 調査の app ログ取得も同経路に乗る。
if ! systemctl is-enabled google-cloud-ops-agent >/dev/null 2>&1; then
  curl -fsSLO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
  bash add-google-cloud-ops-agent-repo.sh --also-install
fi

# 設定は compose 同様 GCS から取得（単一ソース: infra/ops-agent/config.yaml → CI が ops-agent-config.yaml として push）。
mkdir -p /etc/google-cloud-ops-agent
curl -fsS -H "Authorization: Bearer $TOKEN" \
  -o /etc/google-cloud-ops-agent/config.yaml \
  "https://storage.googleapis.com/storage/v1/b/${compose_bucket}/o/ops-agent-config.yaml?alt=media"

systemctl restart google-cloud-ops-agent

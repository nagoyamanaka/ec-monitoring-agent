{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./src/Contexts/Shared/*"],
      "@ec/*": ["./src/Contexts/EC/*"],
      "@monitoring/*": ["./src/Contexts/Monitoring/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

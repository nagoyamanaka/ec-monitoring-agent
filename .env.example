RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_RETRY_TTL=5000
EXCHANGE_NAME=ec-domain-events
MONGODB_URL=mongodb://localhost:27017/ec-monitoring
GEMINI_API_KEY=your-gemini-api-key
PAYMENT_MODE=success
FEEDBACK_AUTO_PROMOTE_THRESHOLD=3
GCP_PROJECT_ID=your-gcp-project-id
DEMO_CONTROLS_ENABLED=true
# 設定すると SimilarIncident を Elasticsearch に永続し、SimilarPatternRule（graded confidence 分類）を有効化する。
# 未設定なら InMemory にフォールバック（従来挙動・分類は完全一致のみ）。
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_SIMILAR_INCIDENTS_INDEX=similar-incidents
# graded confidence のチューニング（任意）。BM25 生スコアの飽和点と棄権閾値。corpus に合わせて調整。
ELASTICSEARCH_SIMILAR_SCORE_CEILING=5
ELASTICSEARCH_SIMILAR_MIN_CONFIDENCE=0.6

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_RETRY_TTL=5000
EXCHANGE_NAME=ec-domain-events
# channel prefetch（未ack同時配信上限）。1 だと長時間ハンドラ（AI調査 ~100秒）が全キューを止める
# ヘッドオブラインブロッキングになる。完了後 ack（at-least-once）を保ったまま並列配信するため引き上げる。
RABBITMQ_PREFETCH=3
MONGODB_URL=mongodb://localhost:27017/ec-monitoring
# Gemini モデルへの到達経路。true で Vertex AI 経由（ADC 認証・GCP 無料クレジット対象・推奨）。
# Vertex 経由なら GEMINI_API_KEY は不要。ローカルで Vertex を使うには事前に
#   gcloud auth application-default login && gcloud config set project <GCP_PROJECT_ID>
# を実行（コンテナで使う場合は ~/.config/gcloud をマウントするか、AI_INVESTIGATION_STUB=true で回避）。
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-pro
# AI Studio フォールバック用（GOOGLE_GENAI_USE_VERTEXAI=false のときのみ使用・APIキー課金）。
GEMINI_API_KEY=your-gemini-api-key
# AI調査の差し替え（優先度 stub > ADK > 単一Gemini）:
#   AI_INVESTIGATION_STUB=true で決定論Stub（ローカルE2E・課金なし）。
#   AI_INVESTIGATION_ADK=true で ADK マルチエージェント自律調査（タスク18・Vertex 必須）。
AI_INVESTIGATION_STUB=false
AI_INVESTIGATION_ADK=false
# ADK 自律ループの LLM 呼び出し上限（トークン暴走の安全弁）。
AI_INVESTIGATION_ADK_MAX_LLM_CALLS=8
# AI調査1件のウォールクロック上限(ms)。ADK 7エージェント自律ループは実測 92-116秒かかり、
# 既定120秒では並列実行時に超過して暫定落ちするため広げる。
AI_INVESTIGATION_TIMEOUT_MS=240000
PAYMENT_MODE=success
FEEDBACK_AUTO_PROMOTE_THRESHOLD=3
# Vertex AI の課金紐付け先プロジェクト（GOOGLE_CLOUD_PROJECT 未設定時はこれを使う）。
GCP_PROJECT_ID=your-gcp-project-id
DEMO_CONTROLS_ENABLED=true
# 設定すると SimilarIncident を Elasticsearch に永続し、SimilarPatternRule（graded confidence 分類）を有効化する。
# 未設定なら InMemory にフォールバック（従来挙動・分類は完全一致のみ）。
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_SIMILAR_INCIDENTS_INDEX=similar-incidents
ELASTICSEARCH_SIMILAR_MIN_CONFIDENCE=0.6
# CI(Trivy/npm audit) → POST /ingest/security-scan の共有トークン（x-ingest-token ヘッダ）
INGEST_TOKEN=your-ingest-token
# リメディエーション（修正PR起票）。GITHUB_TOKEN は対象リポ限定の最小権限 PAT。
# GITHUB_TARGET_REPO は調査（read-only）対象、GITHUB_REMEDIATION_REPO は PR 起票先（未設定なら TARGET_REPO に同じ）。
GITHUB_TOKEN=your-github-token
GITHUB_TARGET_REPO=nagoyamanaka/ec-monitoring-agent
GITHUB_REMEDIATION_REPO=owner/repo
# リメディ実行戦略: advisory=in-processで方針PR(既定・CI不要) / dispatch=CIのAIエージェントへ投げ実修正+UT
REMEDIATION_MODE=advisory
REMEDIATION_DISPATCH_EVENT_TYPE=ai-remediation
# AI自己修正ループの上限回数（既定2）。通らないと延々リトライして課金暴走するのを防ぐ安全弁
REMEDIATION_MAX_ATTEMPTS=2
# （dispatch時・ターゲットリポ側 Secrets）AI修正ジョブが結果を返す callback 先 = backend の ingest URL
# 例: BACKOFFICE_INGEST_URL=https://<cloud-run-url>  （/ingest/remediation-result を叩く）

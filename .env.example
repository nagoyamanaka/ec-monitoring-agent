RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_RETRY_TTL=5000
EXCHANGE_NAME=ec-domain-events
# channel prefetch（未ack同時配信上限）。1 だと長時間ハンドラ（AI調査 ~100秒）が全キューを止める
# ヘッドオブラインブロッキングになる。完了後 ack（at-least-once）を保ったまま並列配信するため引き上げる。
RABBITMQ_PREFETCH=3
MONGODB_URL=mongodb://localhost:27017/ec-monitoring
# Gemini モデルへの到達経路。true で Vertex AI 経由（ADC 認証・GCP 無料クレジット対象・推奨）。
# Vertex 経由なら GEMINI_API_KEY は不要。ローカルで Vertex を使うには事前に
#   gcloud auth application-default login && gcloud config set project <GCP_PROJECT_ID>
# を実行（コンテナで使う場合は ~/.config/gcloud をマウントするか、AI_INVESTIGATION_STUB=true で回避）。
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-pro
# 単一Gemini経路（非ADK・主に edge の再調査 POST /alerts/:id/reinvestigate）の思考トークン予算。
# gemini-2.5-pro は思考も出力予算を消費するため上限にキャップして最終JSON用トークンを残す（第6原因の防御）。
# 有効域 128〜32768・-1 で動的。既定 16384（ADK 経路 AI_INVESTIGATION_COORDINATOR_THINKING_BUDGET と同値）。
GEMINI_THINKING_BUDGET=16384
# AI Studio フォールバック用（GOOGLE_GENAI_USE_VERTEXAI=false のときのみ使用・APIキー課金）。
GEMINI_API_KEY=your-gemini-api-key
# AI調査の差し替え（優先度 stub > ADK > 単一Gemini）:
#   AI_INVESTIGATION_STUB=true で決定論Stub（ローカルE2E・課金なし）。
#   AI_INVESTIGATION_ADK=true で ADK マルチエージェント自律調査（タスク18・Vertex 必須）。
AI_INVESTIGATION_STUB=false
AI_INVESTIGATION_ADK=false
# ADK 自律ループの LLM 呼び出し上限（トークン暴走の安全弁）。
AI_INVESTIGATION_ADK_MAX_LLM_CALLS=8
# AI調査1件のウォールクロック上限(ms)。ADK 8エージェント自律ループは実測 92-116秒かかり、
# 既定120秒では並列実行時に超過して暫定落ちするため広げる。
AI_INVESTIGATION_TIMEOUT_MS=240000
# 相関検証エージェント（correlation_verifier・批判役）専用モデル。1ショット判定なので既定は flash
# （wall-clock 逼迫の緩和）。GEMINI_MODEL と同じにしたい場合は明示指定する。
AI_INVESTIGATION_VERIFIER_MODEL=gemini-2.5-flash
# ロール別の静的モデル割当（D3・sub-agent 軽量化）。推論の薄いロールを flash 化して wall-clock を削る。
# evidence_collector: ツール往復が主・自律ループで最多呼び出し→既定 flash。
AI_INVESTIGATION_COLLECTOR_MODEL=gemini-2.5-flash
# runbook_escalation: 体制マスタ引き＋定型草案→既定 flash。
AI_INVESTIGATION_ESCALATION_MODEL=gemini-2.5-flash
# impact_triage: citation 必須の算定（空なら impact ごと破棄）のため既定は GEMINI_MODEL（未指定時）。
# flash 化を試す場合のみ明示指定する。
# AI_INVESTIGATION_TRIAGE_MODEL=gemini-2.5-flash
# コーディネーターの思考トークン予算（fallback 第6原因＝思考が maxOutputTokens を食い潰す空応答の防御）。
# gemini-2.5-pro は思考も出力予算を消費するため上限にキャップして最終JSON用トークンを残す。
# 有効域 128〜32768・-1 で動的。増やすほど推論は深いが wall-clock が伸びて D3 タイムアウト risk 増。既定16384。
AI_INVESTIGATION_COORDINATOR_THINKING_BUDGET=16384
# 最終JSONの清書役（ADR-26 恒久策）。エージェントループの外で、ツールなし・思考0・responseSchema
# 強制の単発呼び出しを直列に足し、サブエージェント出力群を JSON へ清書させる。responseSchema は
# ツール呼び出しと併用できないため、コーディネーター本体でなく「グラフの外」でだけ効かせられる。
# エージェント数は増えない（8体のまま）。清書がパースを通らなければコーディネーターの下書きへ戻る。
# 既定 on。false で従来挙動（縮退リトライだけで防御）に戻る退避手段。
AI_INVESTIGATION_FINALIZER=true
# 清書役のモデル。推論でなく転記なので既定 flash。
AI_INVESTIGATION_FINALIZER_MODEL=gemini-2.5-flash
# 清書1回のタイムアウト(ms)。調査本体の後ろに直列で乗るので、粘るより下書きへ縮退させる。
AI_INVESTIGATION_FINALIZER_TIMEOUT_MS=30000
PAYMENT_MODE=success
FEEDBACK_AUTO_PROMOTE_THRESHOLD=3
# 予兆ブリーフィング（step6 F系）。既定 off＝/forecast ルートは 404。
# GET /forecast は事前生成済みキャッシュ配信（課金ゼロ）、POST /forecast（生成・Gemini 呼び出し）は DEMO_ENABLED も必要。
FORECAST_ENABLED=true
# horizon はこの固定文字列がそのまま Gemini とページのメタ表示に使われる。
# 録画/デモ前は「今週末（7/5 土〜7/6 日）」のように具体日付にすると window の導出・表示が具体化する。
FORECAST_HORIZON=今週末
# flagship plan-1（バックボーンVM e2-standard-2→e2-small 縮小）の引用チップ「証拠を開く」の解決先。
# 既定は実 PR #83（この plan を CI の terraform plan に通した本物・config.ts に既定値）。空にすると非リンク表示。
# FORECAST_PENDING_PLAN_PR_URL=https://github.com/nagoyamanaka/ec-monitoring-agent/pull/83
# Vertex AI の課金紐付け先プロジェクト（GOOGLE_CLOUD_PROJECT 未設定時はこれを使う）。
GCP_PROJECT_ID=your-gcp-project-id
DEMO_CONTROLS_ENABLED=true
# 設定すると SimilarIncident を Elasticsearch に永続し、SimilarPatternRule（graded confidence 分類）を有効化する。
# 未設定なら InMemory にフォールバック（従来挙動・分類は完全一致のみ）。
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_SIMILAR_INCIDENTS_INDEX=similar-incidents
ELASTICSEARCH_SIMILAR_MIN_CONFIDENCE=0.6
# CI(Trivy/npm audit) → POST /ingest/security-scan の共有トークン（x-ingest-token ヘッダ）
INGEST_TOKEN=your-ingest-token
# リメディエーション（修正PR起票）。GITHUB_TOKEN は対象リポ限定の最小権限 PAT。
# GITHUB_TARGET_REPO は調査（read-only）対象、GITHUB_REMEDIATION_REPO は PR 起票先（未設定なら TARGET_REPO に同じ）。
GITHUB_TOKEN=your-github-token
GITHUB_TARGET_REPO=nagoyamanaka/ec-monitoring-agent
GITHUB_REMEDIATION_REPO=owner/repo
# PR の base ブランチ（空＝既定ブランチ）。dispatch では CI 側の checkout ref も兼ねる
# ＝脆弱性の実体があるブランチを修正し、そこへ PR を戻す（client_payload.baseRef で運ぶ）。
GITHUB_REMEDIATION_BASE_REF=
# リメディ実行戦略: advisory=in-processで方針PR(既定・CI不要) / dispatch=CIのAIエージェントへ投げ実修正+UT
REMEDIATION_MODE=advisory
REMEDIATION_DISPATCH_EVENT_TYPE=ai-remediation
# AI自己修正ループの上限回数（既定2）。通らないと延々リトライして課金暴走するのを防ぐ安全弁
REMEDIATION_MAX_ATTEMPTS=2
# dispatch の確定待ち上限（ms・既定20分）。これを過ぎても CI から callback が来ない dispatched は
# failed へ落とす（ジョブ失敗/宛先未配線/切断のどれでも record を「確定待ち」のまま残さない）。
REMEDIATION_DISPATCH_TIMEOUT_MS=1200000
# （dispatch時・ターゲットリポ側 Secrets）AI修正ジョブが結果を返す callback 先 = backend の ingest URL。
# 名前は他の CI 経路と同じ INGEST_URL に統一（旧 BACKOFFICE_INGEST_URL は廃止）。
# 例: INGEST_URL=https://<cloud-run-url>  （/ingest/remediation-result を叩く）

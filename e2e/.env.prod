# CD smoke 用テンプレート。シークレットはコミットせず CD パイプラインで環境変数として注入する。
# ローカル: node --env-file=.env.prod node_modules/.bin/vitest run --config vitest.e2e.prod.config.ts
EC_BASE_URL=https://ec.example.com
BACKOFFICE_BASE_URL=https://backoffice.example.com
# prod smoke は Mongo に直接アクセスしないため以下は不要（E2E_SEED=false）
MONGO_URL=
MONITORING_MONGO_URL=
E2E_SEED=false

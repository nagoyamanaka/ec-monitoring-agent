# デプロイ操作用 Makefile（ローカル開発用の Makefile とは独立）
# 使い方: make -f Makefile.deploy <target>
#
# 前提: gcloud auth login 済み、必要な権限（osAdminLogin / IAP）が付与されていること。
# 設定は .env.deploy（gitignore 推奨）で上書き可能。
-include .env.deploy

AR_HOST      ?= asia-northeast1-docker.pkg.dev
GCP_PROJECT  ?= ec-monitoring-agent
AR_REPO      ?= apps
GCP_REGION   ?= asia-northeast1
GCE_ZONE     ?= asia-northeast1-a
GCE_INSTANCE ?= ec-monitoring-backbone
DEPLOY_BUCKET ?=

MANUAL := infra/terraform/manual_deploy.sh

.PHONY: deploy-ec deploy-bo deploy-frontend deploy-all \
        backbone-restart upload-compose help

help: ## このヘルプを表示
	@grep -E '^[a-z][a-z-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

# ── サービスデプロイ ──────────────────────────────────────────────────────────

deploy-ec: ## ec-backend をビルド → GAR push → GCE 更新
	$(MANUAL) ec-backend

deploy-bo: ## backoffice-backend をビルド → GAR push → GCE + Cloud Run edge 更新
	$(MANUAL) backoffice-backend

deploy-frontend: ## backoffice-frontend をビルド → GAR push → Cloud Run 更新
	$(MANUAL) backoffice-frontend

deploy-all: ## 全サービスをデプロイ（ec → bo → frontend 順）
	$(MANUAL) all

# ── GCE 個別操作 ─────────────────────────────────────────────────────────────

backbone-restart: ## イメージ変えずに GCE 上の compose を再起動（compose pull なし）
	gcloud compute ssh "$(GCE_INSTANCE)" \
		--project="$(GCP_PROJECT)" \
		--zone="$(GCE_ZONE)" \
		--tunnel-through-iap \
		--command=" \
			docker compose \
				--env-file /opt/app/.env \
				-f /opt/app/docker-compose.base.yml \
				-f /opt/app/docker-compose.prod.yml \
				up -d \
		"

upload-compose: ## docker-compose.prod.yml を GCS にアップロード（GCE 再起動は別途 backbone-restart で）
	@test -n "$(DEPLOY_BUCKET)" || \
		(echo "DEPLOY_BUCKET が未設定。.env.deploy に DEPLOY_BUCKET=<バケット名> を追加してください。" >&2; exit 1)
	gcloud storage cp docker-compose.prod.yml gs://$(DEPLOY_BUCKET)/docker-compose.prod.yml
	@echo "アップロード完了。GCE への反映は: make -f Makefile.deploy backbone-restart"

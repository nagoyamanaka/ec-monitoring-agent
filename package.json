{
  "name": "ec-monitoring-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev:ec": "pnpm --filter @ec-monitoring-agent/ec-backend run dev",
    "start:ec": "pnpm --filter @ec-monitoring-agent/ec-backend run start",
    "dev:backoffice": "pnpm --filter @ec-monitoring-agent/backoffice-backend run dev",
    "start:backoffice": "pnpm --filter @ec-monitoring-agent/backoffice-backend run start",
    "dev:frontend": "pnpm --filter @ec-monitoring-agent/backoffice-frontend run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @ec-monitoring-agent/e2e run test",
    "test:e2e:prod": "pnpm --filter @ec-monitoring-agent/e2e run test:prod",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@elastic/elasticsearch": "^7.17.0",
    "@google-cloud/logging": "^11.2.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google/adk": "^1.3.0",
    "@google/genai": "^2.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "amqplib": "^2.0.1",
    "ioredis": "^5.11.1",
    "mongodb": "^7.3.0",
    "zod": "^4.4.3"
  }
}

{
  "name": "ec-monitoring-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/apps/ec/backend",
    "src/apps/backoffice/backend",
    "src/apps/backoffice/frontend"
  ],
  "scripts": {
    "dev:ec": "npm run dev --workspace=src/apps/ec/backend",
    "dev:backoffice": "npm run dev --workspace=src/apps/backoffice/backend",
    "dev:frontend": "npm run dev --workspace=src/apps/backoffice/frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.219.0"
  }
}
